{
  "name": "miaomiao-search",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm --filter @miaomiao-search/server build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/source-contract.test.mjs && pnpm --filter @miaomiao-search/server test",
    "server:build": "pnpm --filter @miaomiao-search/server build",
    "server:dev": "pnpm --filter @miaomiao-search/server dev",
    "db:migrate": "pnpm --filter @miaomiao-search/server db:migrate"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.1.0"
  }
}
